# %% [markdown]
# ## 1 · Items — three to five, real data, read them

# %%
ITEMS: list[dict] = [
    {"id": "<id>", "text": "<a real item, verbatim>", "gold": "<label>"},
]

# %% [markdown]
# ## 2 · Render — the prompt as the model will see it (zero calls)

# %%
PROMPT = """<the prompt, verbatim — this text becomes the protocol's Prompt field>

{text}
"""


def render(item: dict) -> str:
    return PROMPT.format(**item)


for it in ITEMS:
    print("=" * 72)
    print(render(it))

# %% [markdown]
# ## 3 · Probe — a handful of real calls; raw answers shown, nothing kept

# %%
answers = [llm.complete(MODEL, render(it)) for it in ITEMS]
for it, a in zip(ITEMS, answers):
    print("-" * 72)
    print(it["id"], "· gold:", it["gold"])
    print(a)

