{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.venv/bin/claude-hook\" pre-run",
            "timeout": 120,
            "statusMessage": "claude-hook pre-run: preflight before a run"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.venv/bin/claude-hook\" post-change",
            "timeout": 60,
            "statusMessage": "claude-hook post-change: check what changed"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.venv/bin/claude-hook\" stop",
            "timeout": 120,
            "statusMessage": "claude-hook stop: finalize a written-back number"
          }
        ]
      }
    ]
  }
}
