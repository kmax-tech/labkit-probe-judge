#!/usr/bin/env python3
"""Hold the kept number to its own output — one formula, imported, never copied.

    ../../.venv/bin/python scripts/02_analyze.py            # the metrics, recomputed from OUT
    ../../.venv/bin/python scripts/02_analyze.py --check    # pin OUT to the run, recompute, hold NOTE to it

`labkit.recheck.holds` does the three things every area used to re-implement
(and twice got wrong, 2026-10-05): the output file pinned to the run's
recorded sha, metrics.json against `evaluate_rows()`, the note holding every
reported number and the run_id. The formula is `01_measure.evaluate_rows`,
imported by path under a unique name — a second copy here diverged from the
measurement twice in one day (0.8333 against 0.9167).
"""
from __future__ import annotations

import argparse
import importlib.util
import json
import sys
from pathlib import Path

from labkit import recheck

AREA = Path(__file__).resolve().parent.parent
NOTE = AREA / "PROTOCOL-<name>.md"     # or notes/results/<note>.md once the number is promoted
_spec = importlib.util.spec_from_file_location("measure_<name>", AREA / "scripts" / "01_measure.py")
assert _spec is not None and _spec.loader is not None
measure = importlib.util.module_from_spec(_spec)
sys.modules[_spec.name] = measure
_spec.loader.exec_module(measure)


def main() -> None:
    ap = argparse.ArgumentParser(description=(__doc__ or "").splitlines()[0])
    ap.add_argument("--check", action="store_true",
                    help="pin OUT to the newest run, recompute, hold NOTE to it")
    args = ap.parse_args()
    if args.check:
        # the numbers as protocol-fill --from-run writes them (recheck.plain_numbers):
        # a format of its own here (`:.4f`) failed the check right after the
        # write-back (cold Sonnet, 2026-10-14)
        v = recheck.holds(area=AREA, out=measure.OUT, recompute=measure.evaluate_rows, note=NOTE)
        print(f"check: run {v.run_id} — {v.keys_compared} keys identical, {NOTE.name} carries "
              f"the numbers and the run_id" + (f"; grown: {v.grown}" if v.grown else ""))
        return
    print(json.dumps(measure.evaluate_rows(measure.read_jsonl(measure.OUT)), indent=1))


if __name__ == "__main__":
    main()
